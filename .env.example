# GrainRate reads the process environment directly; it never auto-loads .env.
# Copy this file to .env and `set -a; . ./.env; set +a` if that is your habit,
# or simply export the variables. Every value below is optional - leaving them
# empty (or unset) uses the documented default.

# Directory holding store.json + session. Default: ~/.grainrate
GRAINRATE_HOME=

# Any non-empty value disables ANSI colour (standard NO_COLOR convention).
NO_COLOR=

# Passphrase used by `auth login` / `auth set-passphrase` instead of prompting
# or reading stdin. Only for unattended scripts; unset it in interactive shells.
GRAINRATE_PASSPHRASE=
